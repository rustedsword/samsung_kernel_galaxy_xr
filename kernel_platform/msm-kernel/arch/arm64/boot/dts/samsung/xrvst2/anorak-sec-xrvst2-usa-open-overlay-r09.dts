/dts-v1/;

/ {
	model = "Samsung XR VST Gen2 PROJECT - SM-I610_EMUL_REV01_SONY(board-id,09)";
	compatible = "qcom,anorak-qxr\0qcom,anorak";
	qcom,board-id = <0x20026 0x09>;
	dtbo-version = <0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			regulator-name = "pmxr2230_l17";
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			max77816_fan_i2c {
				label = "max77816_fan_i2c";

				default {
					phandle = <0x01>;

					mux {
						pins = "gpio142\0gpio143";
						function = "gpio";
					};

					config {
						pins = "gpio142\0gpio143";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				active {
					phandle = <0x02>;

					mux {
						pins = "gpio142\0gpio143";
						function = "gpio";
					};

					config {
						pins = "gpio142\0gpio143";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				suspend {
					phandle = <0x03>;

					mux {
						pins = "gpio142\0gpio143";
						function = "gpio";
					};

					config {
						pins = "gpio142\0gpio143";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};

			sec_fan_i2c {
				label = "sec_fan_i2c";

				default {
					phandle = <0x06>;

					mux {
						pins = "gpio140\0gpio141";
						function = "gpio";
					};

					config {
						pins = "gpio140\0gpio141";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				active {
					phandle = <0x08>;

					mux {
						pins = "gpio140\0gpio141";
						function = "gpio";
					};

					config {
						pins = "gpio140\0gpio141";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				suspend {
					phandle = <0x09>;

					mux {
						pins = "gpio140\0gpio141";
						function = "gpio";
					};

					config {
						pins = "gpio140\0gpio141";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			i2c@7 {
				cell-index = <0x07>;
				status = "okay";
				compatible = "i2c-gpio";
				gpios = <0xffffffff 0x8e 0x00 0xffffffff 0x8f 0x00>;
				i2c-gpio,delay-us = <0x02>;
				pinctrl-names = "max77816_fan_i2c_pins_default\0max77816_fan_i2c_pins_active\0max77816_fan_i2c_pins_suspend";
				pinctrl-0 = <0x01>;
				pinctrl-1 = <0x02>;
				pinctrl-2 = <0x03>;
				phandle = <0x13f>;

				max77816@18 {
					status = "okay";
					compatible = "maxim,max77816_fan";
					reg = <0x18>;
					pinctrl-names = "default";
					pinctrl-0 = <0x04>;
					maxim,bob-en-gpio = <0x05 0x06 0x00>;
					regulator-name = "vout";
					regulator-min-microvolt = <0x27ac40>;
					regulator-max-microvolt = <0x4e6e20>;
					regulator-initial-mode = <0x01>;
					phandle = <0x140>;
				};
			};

			i2c@8 {
				cell-index = <0x08>;
				status = "okay";
				compatible = "i2c-gpio";
				gpios = <0xffffffff 0x8c 0x00 0xffffffff 0x8d 0x00>;
				i2c-gpio,delay-us = <0x02>;
				pinctrl-names = "default\0sec_fan_i2c_pins_active\0sec_fan_i2c_pins_suspend";
				pinctrl-0 = <0x06 0x07>;
				pinctrl-1 = <0x08>;
				pinctrl-2 = <0x09>;
				phandle = <0x141>;

				max31760@50 {
					status = "okay";
					compatible = "maxim,max31760";
					reg = <0x50>;
					vdd_fan-supply = <0xffffffff>;
					fan_pulses = <0x02>;
					irq_gpio = <0x05 0x04 0x00>;

					fan@0 {
						reg = <0x00>;
						label = "sec_fan";
					};
				};
			};

			qcom,xr-stdalonevwr-misc {
				status = "disabled";
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			sec_fan {
				status = "okay";
				compatible = "sec_fan";
				step-mapping = <0x00 0xc7 0xdb 0xf9>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pmxr2230@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pmxr2230-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x0a 0x103>;
					io-channel-names = "thermal";
					phandle = <0x0e>;
				};

				pinctrl@8800 {
					compatible = "qcom,pmxr2230-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x12f>;

					pmxr2230_sd_card_therm {

						pmxr2230_sd_card_therm_default {
							pins = "gpio3";
							bias-high-impedance;
							phandle = <0x15>;
						};
					};

					pmxr2230_optics_therm {

						pmxr2230_optics_therm_default {
							pins = "gpio4";
							bias-high-impedance;
							phandle = <0x16>;
						};
					};

					gpio10_adc {

						pmxr2230_gpio10_adc_default {
							pins = "gpio10";
							function = "normal";
							bias-high-impedance;
							phandle = <0x108>;
						};
					};

					key_vol_up {

						key_vol_up_default {
							pins = "gpio1";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0x12e>;
						};
					};

					usb_thm {

						usb_thm_default {
							pins = "gpio4";
							function = "normal";
							bias-high-impedance;
							phandle = <0x131>;
						};
					};
				};

				pwms@e800 {
					compatible = "qcom,pwm-lpg";
					reg = <0xe800>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x03>;
					nvmem = <0x0b 0x0c>;
					nvmem-names = "lpg_chan_sdam\0lut_sdam";
					qcom,lut-sdam-base = <0x45>;
					qcom,lut-patterns = <0x00 0x0a 0x14 0x1e 0x28 0x32 0x3c 0x46 0x50 0x5a 0x64 0x5a 0x50 0x46 0x3c 0x32 0x28 0x1e 0x14 0x0a 0x00>;
					qcom,tick-duration-us = <0x1e78>;
					phandle = <0x0d>;

					lpg@1 {
						qcom,lpg-chan-id = <0x01>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x48>;
					};

					lpg@2 {
						qcom,lpg-chan-id = <0x02>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x56>;
					};

					lpg@3 {
						qcom,lpg-chan-id = <0x03>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x64>;
					};
				};

				pwms@eb00 {
					compatible = "qcom,pwm-lpg";
					reg = <0xeb00>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x01>;
					phandle = <0x142>;
				};

				qcom,leds@ef00 {
					compatible = "qcom,tri-led";
					reg = <0xef00>;
					sec_svcled;
					step = <0xff>;
					phandle = <0x143>;

					red {
						label = "red";
						pwms = <0x0d 0x00 0xf4240>;
						led-sources = <0x00>;
						linux,default-trigger = "none";
						br_ratio_normal = <0xff>;
						br_ratio_lpm = <0x0a>;
					};

					green {
						label = "green";
						pwms = <0x0d 0x01 0xf4240>;
						led-sources = <0x01>;
						linux,default-trigger = "none";
						br_ratio_normal = <0xff>;
						br_ratio_lpm = <0x0a>;
					};

					blue {
						label = "blue";
						pwms = <0x0d 0x02 0xf4240>;
						led-sources = <0x02>;
						linux,default-trigger = "none";
						br_ratio_normal = <0xff>;
						br_ratio_lpm = <0x0a>;
					};
				};

				qcom,flash_led@ee00 {
					compatible = "qcom,pm8350c-flash-led";
					reg = <0xee00>;
					interrupts = <0x01 0xee 0x00 0x01 0x01 0xee 0x03 0x01 0x01 0xee 0x04 0x01>;
					interrupt-names = "led-fault-irq\0all-ramp-down-done-irq\0all-ramp-up-done-irq";
					qcom,thermal-derate-current = <0xc8 0x1f4>;
					status = "okay";
					phandle = <0x144>;

					qcom,flash_0 {
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x145>;
					};

					qcom,flash_1 {
						label = "flash";
						qcom,led-name = "led:flash_1";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,id = <0x01>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x146>;
					};

					qcom,flash_2 {
						label = "flash";
						qcom,led-name = "led:flash_2";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,id = <0x02>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x147>;
					};

					qcom,flash_3 {
						label = "flash";
						qcom,led-name = "led:flash_3";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash3_trigger";
						qcom,id = <0x03>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x148>;
					};

					qcom,torch_0 {
						label = "torch";
						qcom,led-name = "led:torch_0";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,id = <0x00>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x11f>;
					};

					qcom,torch_1 {
						label = "torch";
						qcom,led-name = "led:torch_1";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch1_trigger";
						qcom,id = <0x01>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x121>;
					};

					qcom,torch_2 {
						label = "torch";
						qcom,led-name = "led:torch_2";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch2_trigger";
						qcom,id = <0x02>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x122>;
					};

					qcom,torch_3 {
						label = "torch";
						qcom,led-name = "led:torch_3";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch3_trigger";
						qcom,id = <0x03>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x149>;
					};

					qcom,led_switch_0 {
						label = "switch";
						qcom,led-name = "led:switch_0";
						qcom,default-led-trigger = "switch0_trigger";
						qcom,led-mask = <0x01>;
						qcom,symmetry-en;
						phandle = <0x120>;
					};

					qcom,led_switch_1 {
						label = "switch";
						qcom,led-name = "led:switch_1";
						qcom,default-led-trigger = "switch1_trigger";
						qcom,led-mask = <0x06>;
						qcom,symmetry-en;
						phandle = <0x123>;
					};

					qcom,led_switch_2 {
						label = "switch";
						qcom,led-name = "led:switch_2";
						qcom,default-led-trigger = "switch2_trigger";
						qcom,led-mask = <0x0f>;
						qcom,symmetry-en;
						phandle = <0x14a>;
					};
				};

				bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x01 0x47 0x00 0x00 0x01 0x47 0x01 0x00 0x01 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x0f>;
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			pmxr2230_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x0e>;
				phandle = <0x14b>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x14c>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x14d>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x14e>;
					};
				};
			};

			pmxr2230-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x0f 0x05>;

				trips {

					bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x1e>;
					};
				};
			};

			pmxr2230-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x0f 0x06>;

				trips {

					bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x1f>;
					};
				};
			};

			pmxr2230-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x0f 0x07>;

				trips {

					bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x20>;
					};
				};
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8550ve_f@5 {
				compatible = "qcom,spmi-pmic";
				reg = <0x05 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pm8550ve-f-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x05 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x0a 0x503>;
					io-channel-names = "thermal";
					phandle = <0x10>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x05>;

					pwr_en_gpio {

						pwr_en_gpio_default {
							pins = "gpio6";
							function = "normal";
							power-source = <0x00>;
							output-high;
							input-disable;
							phandle = <0x04>;
						};
					};

					driver_en_gpio {

						driver_en_gpio_default {
							pins = "gpio5";
							function = "normal";
							power-source = <0x00>;
							output-low;
							input-disable;
							phandle = <0x1d>;
						};
					};

					ff_gpio {

						ff_gpio_default {
							pins = "gpio4";
							function = "normal";
							power-source = <0x02>;
							bias-disable;
							input-enable;
							phandle = <0x07>;
						};
					};
				};
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			pm8550ve_f_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x10>;
				phandle = <0x14f>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x150>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x151>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x152>;
					};
				};
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8550vs@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x153>;

				pm8550vs-c-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x02 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x0a 0x203>;
					io-channel-names = "thermal";
					phandle = <0x11>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550vs-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x154>;
				};
			};

			qcom,pm8550vs@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x155>;

				pm8550vs-d-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x03 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x0a 0x303>;
					io-channel-names = "thermal";
					phandle = <0x12>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550vs-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x156>;
				};
			};

			qcom,pm8550vs@4 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "disabled";
				phandle = <0x157>;

				pm8550vs-e-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
