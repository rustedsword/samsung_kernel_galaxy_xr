#
# PDIC devices
#

comment "PDIC configs"

config PDIC_S2MM006
	tristate "Using S2MM006 USB PD"
	default n
	help
	  If you say yes here you will get support for
	  for the S2MU106 USBPD chip.

config MUIC_S2MM006
	tristate "Using S2MM006 MUIC"
	depends on USE_MUIC
	default n
	help
	  If you say yes here you will get support for the S2MU106 MUIC chip.

config PDIC_ALTERNATE_MODE
	bool "PDIC_ALTERNATE_MODE"
	depends on I2C
	default n
	help
	  If you say yes here you will get support for
	  PDIC_ALTERNATE_MODE

config S2MM006_FW_DOWNLOAD
	bool "S2MM006_FW_DOWNLOAD"
	depends on I2C
	default n
	help
	  If you say yes here you will get support for
	  s2mm006 FW UPDATE

config S2MM006_POGO
	bool "S2MM006_POGO"
	depends on I2C
	default n
	help
	  If you say yes here you will get support for
	  2nd pogo connector with s2mm006 driver

config S2MM006_CC_UEVENT
	bool "S2MM006_CC_UEVENT"
	depends on I2C
	default n
	help
	  If you say yes here you will get support for
	  power control cc uevent with s2mm006 driver
