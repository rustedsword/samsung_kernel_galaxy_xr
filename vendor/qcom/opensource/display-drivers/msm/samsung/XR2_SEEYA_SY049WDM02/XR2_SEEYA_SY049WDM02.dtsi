					29 00 00 00 00 00 02 D1 02

					/* CMD2 P1 */
					29 00 00 00 00 00 03 F0 AA 11
					29 00 00 00 00 00 0A C2 01 66 01 66 01 66 00 90 02

					/* CMD2 P2 */
					29 00 00 00 00 00 03 F0 AA 12
					29 00 00 00 00 00 02 D3 20
					29 00 00 00 00 00 03 BF 07 BE

					/* CMD3 P1 */
					29 00 00 00 00 00 03 FF 5A 81
					29 00 00 00 00 00 02 65 0B
					29 00 00 00 14 00 0E F9		/* delay_ms(20) */
						58 5F 66 6D 74 7B 82 89
						90 97 9E A5 AC

					05 00 00 00 64 00 01 11		/* delay_ms(100) */

					05 00 00 00 14 00 01 29 	/* delay_ms(20) */
					29 00 00 00 00 00 03 F0 AA 11
					29 00 00 00 00 00 02 C0 FF
				];

				qcom,mdss-dsi-on-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-off-command=[
					05 01 00 00 00 00 01 28		/* display off */
					05 01 00 00 00 00 01 10		/* sleep in */
				];
				qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
				qcom,compression-mode = "dsc";
				qcom,mdss-dsc-encoders = <2>;
				qcom,mdss-dsc-slice-height = <24>;
				qcom,mdss-dsc-slice-width = <1272>;
				qcom,mdss-dsc-slice-per-pkt = <1>;
				qcom,mdss-dsc-bit-per-component = <8>;
				qcom,mdss-dsc-bit-per-pixel = <8>;
				qcom,mdss-dsc-block-prediction-enable;
			};
		};
