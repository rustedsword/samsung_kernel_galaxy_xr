			29 00 00 00 00 00 07 C2 01 66 01 66 01 66	/* EM=100%*/
		];

		samsung,candela_map_table_revA = < /* THIS TABLE USED FOR DIMMING */
		/* <idx> <from> <till> <gm2_wrdisbv> <cd> */
			0	0	49	71	10
			1	50	99	143	20
			2	100	149	214	30
			3	150	199	286	40
			4	200	255	358	50
		>;

		/*
		* ************************************************************************************************************************
		* MULTI_RESOLUTION (DSC configs were moved all to below timing set)
		* (C10P does not support MULTI_RESOLUTION, only FHD.)
		* ************************************************************************************************************************
		*/
		qcom,mdss-dsi-display-timings {
			fhd75 {
				qcom,display-topology = <2 2 2>;
				qcom,default-topology-index = <0>;

				qcom,mdss-dsi-panel-width = <1272>; /* 2544 / 2(intf_num) */
				qcom,mdss-dsi-panel-height = <2544>;

				qcom,mdss-dsi-t-clk-pre = <0x14>;
				qcom,mdss-dsi-t-clk-post = <0x0B>;
				qcom,mdss-dsi-panel-phy-timings = [00 16 06 05 14 1F 06 06 06 02 04 00 14 0B];
				qcom,mdss-dsi-panel-framerate = <75>;

				qcom,mdss-dsi-h-pulse-width = <32>;
				qcom,mdss-dsi-h-back-porch = <32>;
				qcom,mdss-dsi-h-front-porch = <64>;
