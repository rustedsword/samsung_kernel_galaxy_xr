			39 00 00 00 00 00 01 00
			39 00 00 00 00 00 01 00
			39 00 00 00 00 00 01 00
		];

		samsung,gamma_mode2_normal_tx_cmds_revA = [
			39 00 00 00 00 00 02 51 00
			39 00 00 00 00 00 02 B0 00
			39 00 00 00 00 00 02 FF 01
			39 00 00 00 00 00 02 EC 20
			39 00 00 00 00 00 02 FF 03
			39 00 00 00 00 00 3D B4
				28 E2 8E 28 E2 8E 28 E2 8E 28 E2 8E 28 E2 8E
				28 E2 8E 28 E2 8E 28 E2 8E 28 E2 8E 28 E2 8E
				28 E2 8E 28 E2 8E 28 E2 8E 28 E2 8E 28 E2 8E
				28 E2 8E 28 E2 8E 28 E2 8E 28 E2 8E 28 E2 8E
			39 00 00 00 00 00 02 FF 01
			39 00 00 00 00 00 02 EC 60
			39 00 00 00 00 00 02 B0 03
		];

		samsung,candela_map_table_revA = < /* THIS TABLE USED FOR DIMMING */
		/* <idx> <from> <till> <gm2_wrdisbv> <cd> */
			0	0	30	00	300
			1	31	60	00	400
			2	61	90	00	500
			3	91	120	51	600
			4	121	150	102	700
			5	151	180	153	800
			6	181	210	204	900
			7	211	255	255	1000
		>;

		/*
		* ************************************************************************************************************************
		* MULTI_RESOLUTION (DSC configs were moved all to below timing set)
		* (C10P does not support MULTI_RESOLUTION, only FHD.)
		* ************************************************************************************************************************
		*/
		qcom,mdss-dsi-display-timings {
			4K60 {
				qcom,display-topology = <4 4 2>;
				qcom,default-topology-index = <0>;

				qcom,mdss-dsi-panel-width = <1776>; /* 2544 / 2(intf_num) */
				qcom,mdss-dsi-panel-height = <3840>;

				qcom,mdss-dsi-t-clk-pre = <0x24>;
				qcom,mdss-dsi-t-clk-post = <0x11>;
				qcom,mdss-dsi-panel-phy-timings = [00 2B 0C 0C 1C 26 0C 0C 0B 02 04 00 24 11];
				qcom,mdss-dsi-panel-framerate = <90>;

				qcom,mdss-dsi-h-pulse-width = <4>;
				qcom,mdss-dsi-h-back-porch = <24>;
				qcom,mdss-dsi-h-front-porch = <28>;
				qcom,mdss-dsi-h-sync-skew = <0>;
				qcom,mdss-dsi-v-pulse-width = <1>;
				qcom,mdss-dsi-v-back-porch = <18>;
				qcom,mdss-dsi-v-front-porch = <29>;
				qcom,mdss-dsi-on-command = [
					/* 1. Set Compression Mode */
					39 00 00 00 00 00 02 03 11
					/* 2. DSC PPS Setting */
					39 00 00 00 00 00 5F F6
						11 00 00 89 30 80 0F 00
						0D E0 00 18 03 78 03 78
						02 00 02 BC 00 20 02 DD
						00 0C 00 0C 04 2D 02 94
						18 00 10 F0 03 0C 20 00
						06 0B 0B 33 0E 1C 2A 38
						46 54 62 69 70 77 79 7B
						7D 7E 01 02 01 00 09 40
						09 BE 19 FC 19 FA 19 F8
						1A 38 1A 78 1A B6 2A F6
						2B 34 2B 74 3B 74 6B F4
						00 00 00 00 00 00
					/* 3. Video Mode Signal Control */
					39 00 00 00 00 00 0F 3B
						00 13 00 1D 00 00 06 17
						05 9F 04 C7 03 AF
					/* 4. Write Display Brightness */
					39 00 00 00 00 00 02 51 FF
					/* 5. Write Control Display */
					39 00 00 00 00 00 02 53 20
					/* 6. GMASET */
					39 00 00 00 00 00 02 26 01
					/* 7. Set up scaling */
					39 00 00 00 00 00 02 65 00
				];

				qcom,mdss-dsi-on-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-off-command=[
					39 01 00 00 00 00 01 28		/* display off */
					39 01 00 00 30 00 01 10		/* sleep in */
				];
				qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
				qcom,compression-mode = "dsc";
				qcom,mdss-dsc-slice-height = <24>;
				qcom,mdss-dsc-slice-width = <888>;
				qcom,mdss-dsc-slice-per-pkt = <1>;
				qcom,mdss-dsc-bit-per-component = <8>;
				qcom,mdss-dsc-bit-per-pixel = <8>;
				qcom,mdss-dsc-version = <0x11>;
				qcom,mdss-dsc-block-prediction-enable;
			};
		};
	};
};
