&mdss_mdp0 {
	XR2_SONY_ECX344A_SUB: XR2_SONY_ECX344A_SUB {
		qcom,mdss-dsi-panel-name = "XR2_SONY_ECX344A_SUB";
		label = "XR2_SONY_ECX344A_SUB";

		qcom,mdss-dsi-bpp = <24>;
		qcom,mdss-dsi-h-left-border = <0>;
		qcom,mdss-dsi-h-right-border = <0>;
		qcom,mdss-dsi-v-top-border = <0>;
		qcom,mdss-dsi-v-bottom-border = <0>;

		qcom,mdss-dsi-underflow-color = <0xFF>;
		qcom,mdss-dsi-border-color = <0>;

		qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";

		qcom,mdss-dsi-interleave-mode = <0>;
		qcom,mdss-dsi-panel-type = "dsi_video_mode";
		qcom,mdss-dsi-wr-mem-start = <0x2C>;
		qcom,mdss-dsi-wr-mem-continue = <0x3C>;

		qcom,mdss-dsi-bllp-eof-power-mode;
		qcom,mdss-dsi-bllp-power-mode;
		qcom,mdss-dsi-traffic-mode= "non_burst_sync_event";

		qcom,mdss-dsi-pixel-packing = "loose";

		qcom,mdss-dsi-virtual-channel-id = <0>;
		qcom,mdss-dsi-color-order = "rgb_swap_rgb";
		qcom,mdss-dsi-lane-0-state;
		qcom,mdss-dsi-lane-1-state;
		qcom,mdss-dsi-lane-2-state;
		qcom,mdss-dsi-lane-3-state;
		qcom,mdss-dsi-lane-map = "lane_map_0123";

		qcom,mdss-dsi-stream = <0>;
		qcom,mdss-dsi-mdp-trigger = "none";
		qcom,mdss-dsi-dma-trigger = "trigger_sw";

		qcom,mdss-pan-physical-width-dimension = <23>;
		qcom,mdss-pan-physical-height-dimension = <25>;

		qcom,mdss-dsi-panel-mode-gpio-state = "invalid";

		/* temp add to avoid error log */
		qcom,mdss-dsi-reset-sequence = <1 5>, <0 2>, <1 20>;

		qcom,mdss-dsi-init-delay-us = <1000>;
		qcom,mdss-dsi-rx-eot-ignore;

		qcom,mdss-dsi-panel-hdr-enabled;
		qcom,mdss-dsi-panel-hdr-color-primaries = <14880 15935 32435
			16555 14945 30910 7790 3415>;
		qcom,mdss-dsi-panel-peak-brightness = <5643000>;
		qcom,mdss-dsi-panel-average-brightness = <2000000>;
		qcom,mdss-dsi-panel-blackness-level = <6134>;

		qcom,esd-check-enabled;
		qcom,mdss-dsi-panel-status-check-mode ="irq_check";
		samsung,esd-irq-trigger1 = "falling";

		qcom,mdss-dsi-bl-min-level = <1>;
		qcom,mdss-dsi-bl-max-level = <255>;
		qcom,mdss-brightness-max-level = <255>;
		qcom,mdss-brightness-default-level = <30>;
		/* VRR for video mode */
		qcom,dsi-supported-dfps-list = <90 72 60>;
		qcom,mdss-dsi-pan-enable-dynamic-fps;
		qcom,mdss-dsi-pan-fps-update = "dfps_immediate_porch_mode_hfp";

		/* dynamic resolution for video mode */
		qcom,mdss-dms-vid-type = "dms-vid-seamless";

		/* *************************************************************
		 *  Rx (Module Information READ)
		 * *************************************************************
		 */
		samsung,manufacture_id0_rx_cmds_revA	= [06 01 00 00 00 00 01 DA 01 00];
		samsung,manufacture_id1_rx_cmds_revA	= [06 01 00 00 00 00 01 DB 01 00];
		samsung,manufacture_id2_rx_cmds_revA	= [06 01 00 00 00 00 01 DC 01 00];
		samsung,module_info_rx_cmds_revA 	= [06 01 00 00 00 00 01 A1 01 00];
		samsung,mtp_read_sysfs_rx_cmds_revA	= [06 01 00 00 00 00 01 00 00 00];
		samsung,mtp_write_sysfs_tx_cmds_revA	= [
			39 00 00 00 00 00 3D 00
						00 00 00 00 00 00 00 00 00 00
						00 00 00 00 00 00 00 00 00 00
						00 00 00 00 00 00 00 00 00 00
						00 00 00 00 00 00 00 00 00 00
						00 00 00 00 00 00 00 00 00 00
						00 00 00 00 00 00 00 00 00 00
		];

		samsung,vst_thermistor_rx_cmds_revA 	= [06 01 00 00 00 00 01 62 01 00];

		/*
		 * *******************************************************************
		 *	Below  parameters are samsung dependent things
		 * *******************************************************************
		 */
		samsung,panel-vendor = "SONY";
		samsung,disp-model = "ECX344A";
		samsung,support_gamma_mode2;
		samsung,support_factory_panel_swap;
		/* samsung_power_on_pre_lp11_seq : VDD on -> LP11 -> Delay -> reset */
		samsung,power_on_pre_lp11_seq;
		samsung,power_on_pre_lp11_seq_delay_us = <3000>;
		samsung,display_on_tx_cmds_revA = [
			39 00 00 00 60 00 01 11
			/* IRDC https://docs.google.com/document/d/1cKhEZYZxscKz3XxZHWIIkOQyj8FYKBFVoHYLud3UrUU */
			39 00 00 00 00 00 02 b0 00 /* Unlock */
			39 00 00 00 00 00 02 ff 01 /* Page 1 */
			39 00 00 00 00 00 0e cc 8d e0 02 32 32 32 32 32 32 32 32 32 01 /* MFG Code */
			39 00 00 00 00 00 b2 d1 /* IRDC parameters */
			0d ff 00 ff 00 03 0c 1e
			38 5b 89 c0 ff 00 03 0c
			1e 38 5b 89 c0 ff 00 03
			0c 1e 38 5b 89 c0 ff ec
			ec e5 df f2 ff ff f2 f2
			ff ff f2 ec ec e5 df ec
			ec e5 df f2 ff ff f2 f2
			ff ff f2 ec ec e5 df 00
			20 b6 80 80 80 80 80 80
			80 80 80 80 80 80 80 80
			80 80 80 80 80 80 80 80
			80 80 80 80 80 80 80 80
			80 80 80 80 80 80 80 80
			80 80 80 80 80 80 80 80
			80 80 80 80 80 00 00 00
			00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00
			00 00 00 17 bb 0d e0 80
			00
			39 00 00 00 00 00 02 b0 03 /* Lock */
			/* Display On */
			39 00 00 00 00 00 01 29
		];

		/* BRIGHTNESS_MAX_PACKET = 100 */
		samsung,brightness_tx_cmds_revA = [
			39 00 00 00 00 00 01 00
			39 00 00 00 00 00 01 00
			39 00 00 00 00 00 01 00
			39 00 00 00 00 00 01 00
			39 00 00 00 00 00 01 00
			39 00 00 00 00 00 01 00
			39 00 00 00 00 00 01 00
