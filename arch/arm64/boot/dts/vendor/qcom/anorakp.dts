/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. AnorakP SoC";
	compatible = "qcom,anorakp";
	qcom,msm-id = <0x289 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	chosen {
		bootargs = "loglevel=7 log_buf_len=256K kernel.panic_on_rcu_stall=1 loop.max_part=7 pcie_ports=compat service_locator.enable=1 msm_rtb.filter=0x237 allow_mismatched_32bit_el0 kasan=off rcupdate.rcu_expedited=1 rcu_nocbs=0-5 pstore.compress=none kpti=off swiotlb=noforce allow_file_spec_access can.stats_timer=0 disable_dma32=on cpufreq.default_governor=performance kswapd_per_node=2";
		phandle = <0x22f>;
	};

	ddr-regions {
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x230>;

		hyp_qheebsp_region@80000000 {
			no-map;
			reg = <0x00 0x80000000 0x00 0x200000>;
			phandle = <0x231>;
		};

		hyp_data_region@80200000 {
			no-map;
			reg = <0x00 0x80200000 0x00 0x400000>;
			phandle = <0x232>;
		};

