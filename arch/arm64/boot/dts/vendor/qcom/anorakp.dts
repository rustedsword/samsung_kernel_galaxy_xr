	idle-states {

		gold-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <0x190>;
			exit-latency-us = <0x578>;
			min-residency-us = <0x89f>;
			arm,psci-suspend-param = <0x40000003>;
			local-timer-stop;
			phandle = <0x02>;
		};

		gold-c4 {
			compatible = "arm,idle-state";
			idle-state-name = "rail-pc";
			entry-latency-us = <0x258>;
			exit-latency-us = <0x514>;
			min-residency-us = <0x1fc8>;
			arm,psci-suspend-param = <0x40000004>;
			local-timer-stop;
			phandle = <0x03>;
		};

		gold-plus-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <0x12c>;
			exit-latency-us = <0x5aa>;
			min-residency-us = <0xc9e>;
			arm,psci-suspend-param = <0x40000003>;
			local-timer-stop;
			phandle = <0x0a>;
		};

		gold-plus-c4 {
			compatible = "arm,idle-state";
			idle-state-name = "rail-pc";
			entry-latency-us = <0x1f4>;
			exit-latency-us = <0x546>;
			min-residency-us = <0x1d38>;
			arm,psci-suspend-param = <0x40000004>;
			local-timer-stop;
			phandle = <0x0b>;
		};

		cluster-d4 {
			compatible = "domain-idle-state";
			idle-state-name = "l3-off";
			entry-latency-us = <0x41a>;
			exit-latency-us = <0x9c4>;
			min-residency-us = <0x245d>;
			arm,psci-suspend-param = <0x41000044>;
			phandle = <0x1b>;
		};

		cluster-e3 {
			compatible = "domain-idle-state";
			idle-state-name = "llcc-off";
			entry-latency-us = <0xa8c>;
			exit-latency-us = <0xdac>;
			min-residency-us = <0x3687>;
			arm,psci-suspend-param = <0x4100c344>;
			phandle = <0x1c>;
		};
	};

	soc {
		interrupt-parent = <0x01>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0x250>;

		psci {
			compatible = "arm,psci-1.0";
			method = "smc";

			cpu-pd0 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				phandle = <0x04>;
			};

			cpu-pd1 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				phandle = <0x08>;
			};

			cpu-pd2 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				phandle = <0x0c>;
			};

			cpu-pd3 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				phandle = <0x0e>;
			};

			cpu-pd4 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				phandle = <0x10>;
			};

			cpu-pd5 {
				#power-domain-cells = <0x00>;
				power-domains = <0x1a>;
				phandle = <0x12>;
			};

			cluster-pd {
				#power-domain-cells = <0x00>;
				domain-idle-states = <0x1b 0x1c>;
				phandle = <0x1a>;
			};
		};

		bamdma@3304000 {
			compatible = "qcom,bam-v1.7.0";
			qcom,controlled-remotely;
			reg = <0x3304000 0x20000 0x326b000 0x1000>;
			reg-names = "bam\0bam_remote_mem";
			num-channels = <0x1f>;
			interrupts = <0x00 0xa4 0x04>;
			#dma-cells = <0x01>;
			qcom,ee = <0x01>;
			qcom,num-ees = <0x02>;
			phandle = <0x1d>;
		};

		slim@3340000 {
			compatible = "qcom,slim-ngd-v1.5.0";
			reg = <0x3340000 0x2c000 0x326a000 0x1000>;
			reg-names = "ctrl\0slimbus_remote_mem";
			interrupts = <0x00 0xa3 0x04>;
			qcom,apps-ch-pipes = <0x00>;
			qcom,ea-pc = <0x480>;
			dmas = <0x1d 0x03 0x1d 0x04>;
			dma-names = "rx\0tx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";
			phandle = <0x251>;

			ngd@1 {
				reg = <0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				btfmslim-driver {
					compatible = "slim217,221";
					reg = <0x01 0x00>;
					phandle = <0x252>;
				};
			};
		};

		interrupt-controller@17200000 {
