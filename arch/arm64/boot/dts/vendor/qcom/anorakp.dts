	aliases {
		swr3 = "/soc/spf_core_platform/lpass-cdc/wsa2-macro@31E0000/wsa2_swr_master";
		swr2 = "/soc/spf_core_platform/lpass-cdc/va-macro@33F0000/va_swr_master";
		swr1 = "/soc/spf_core_platform/lpass-cdc/rx-macro@3200000/rx_swr_master";
		swr0 = "/soc/spf_core_platform/lpass-cdc/wsa-macro@3240000/wsa_swr_master";
		ufshc1 = "/soc/ufshc@1d84000";
		mmc1 = "/soc/sdhci@8804000";
		serial0 = "/soc/qcom,qup_uart@998000";
		hsuart0 = "/soc/qcom,qup_uart@994000";
		phandle = <0x24f>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			cpu-idle-states = <0x02 0x03>;
			power-domains = <0x04>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			#cooling-cells = <0x02>;
			qcom,freq-domain = <0x06 0x00 0x02>;
			phandle = <0x14>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x05>;

				l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x07>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x02 0x03>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			next-level-cache = <0x09>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			#cooling-cells = <0x02>;
			qcom,freq-domain = <0x06 0x00 0x02>;
			phandle = <0x15>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x09>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			cpu-idle-states = <0x0a 0x0b>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x0d>;
			capacity-dmips-mhz = <0x433>;
			dynamic-power-coefficient = <0x55>;
			#cooling-cells = <0x02>;
			qcom,freq-domain = <0x06 0x01 0x04>;
			phandle = <0x16>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x0d>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			cpu-idle-states = <0x0a 0x0b>;
			power-domains = <0x0e>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x0f>;
			capacity-dmips-mhz = <0x433>;
			dynamic-power-coefficient = <0x55>;
			#cooling-cells = <0x02>;
			qcom,freq-domain = <0x06 0x01 0x04>;
			phandle = <0x17>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x0f>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			cpu-idle-states = <0x0a 0x0b>;
			power-domains = <0x10>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x11>;
			capacity-dmips-mhz = <0x433>;
			dynamic-power-coefficient = <0x55>;
			#cooling-cells = <0x02>;
			qcom,freq-domain = <0x06 0x01 0x04>;
			phandle = <0x18>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x11>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x500>;
			cpu-idle-states = <0x0a 0x0b>;
			power-domains = <0x12>;
			power-domain-names = "psci";
			enable-method = "psci";
