# Galaxy XR standalone development kernel.
CONFIG_LOCALVERSION="-galaxyxr"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_GALAXYXR_AUDIO=m
CONFIG_GALAXYXR_DISPLAY=m
CONFIG_GALAXYXR_CAMERA=m
CONFIG_GALAXYXR_VIDEO=m
CONFIG_GALAXYXR_EVA=m
CONFIG_GALAXYXR_MMRM=m
CONFIG_QCA_CLD_WLAN=m
CONFIG_LTO_NONE=y
CONFIG_INIT_STACK_NONE=y
# CONFIG_UH is not set
# CONFIG_RKP is not set
# CONFIG_KDP is not set
# CONFIG_KDP_CRED is not set
# CONFIG_RKP_TEST is not set
# CONFIG_KDP_TEST is not set
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_BTI_KERNEL is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_STACKPROTECTOR_STRONG is not set
# CONFIG_STACKPROTECTOR_PER_TASK is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_CLANG_SHADOW is not set
# CONFIG_CFI_PERMISSIVE is not set
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_FORTIFY_SOURCE is not set
# CONFIG_HARDENED_USERCOPY is not set
# CONFIG_SLAB_FREELIST_HARDENED is not set
# CONFIG_SLAB_FREELIST_RANDOM is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_GCC_PLUGIN_RANDSTRUCT is not set
# CONFIG_INIT_STACK_ALL_ZERO is not set
# CONFIG_INIT_STACK_ALL_PATTERN is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_WERROR is not set
CONFIG_BUILD_ARM64_DT_OVERLAY=y
# CONFIG_UBSAN is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_KFENCE is not set
# CONFIG_SHUFFLE_PAGE_ALLOCATOR is not set
# CONFIG_ARM64_MTE is not set
