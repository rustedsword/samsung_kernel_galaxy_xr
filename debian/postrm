#!/bin/sh
set -e

version=${DPKG_MAINTSCRIPT_PACKAGE#linux-image-}

export DEB_MAINT_PARAMS="$*"
if [ -d /etc/kernel/postrm.d ]; then
	run-parts --report --exit-on-error --arg="$version" --arg="/boot/vmlinuz-$version" /etc/kernel/postrm.d
fi

if [ "$1" = remove ] || [ "$1" = purge ]; then
	rm -f /usr/lib/modules/"$version"/modules.*
	rmdir /usr/lib/modules/"$version" 2>/dev/null || true
fi

#DEBHELPER#

exit 0
