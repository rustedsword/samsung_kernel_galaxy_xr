#!/bin/sh
set -e

version=${DPKG_MAINTSCRIPT_PACKAGE#linux-image-}
pending=/usr/lib/linux/triggers/$version

# The hooks run from the trigger, after the rest of the dpkg run
# (dracut, xrboot-kernel-install) is configured
case $1 in
	configure)
		mkdir -p "${pending%/*}"
		echo "$*" > "$pending"
		dpkg-trigger --no-await "linux-update-$version"
		;;
	triggered)
		if [ -f "$pending" ]; then
			linux-run-hooks image postinst "$version" "/boot/vmlinuz-$version" -- $(cat "$pending")
			rm -f "$pending"
		fi
		;;
esac

#DEBHELPER#

exit 0
