#!/bin/sh
set -e

version=${DPKG_MAINTSCRIPT_PACKAGE#linux-image-}

if [ "$1" = configure ]; then
	depmod -a -F "/boot/System.map-$version" "$version"
fi

export DEB_MAINT_PARAMS="$*"
export INITRD=Yes
if [ -d /etc/kernel/postinst.d ]; then
	run-parts --report --exit-on-error --arg="$version" --arg="/boot/vmlinuz-$version" /etc/kernel/postinst.d
fi

#DEBHELPER#

exit 0
